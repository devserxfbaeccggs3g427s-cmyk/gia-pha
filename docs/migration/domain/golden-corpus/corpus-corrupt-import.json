      "document": {
        "tree": { "id": "t1", "name": "Corpus", "ownerId": "u1", "memberships": [] },
        "members": [
          {
            "id": "m1", "treeId": "t1", "firstName": "An", "lastName": "Nguyễn", "fullName": "Nguyễn An",
            "gender": "MALE", "isAlive": true, "createdAt": "2025-01-01T00:00:00.000Z", "updatedAt": "2025-01-01T00:00:00.000Z",
            "zodiacSign": "Tiger"
          }
        ],
        "relationships": [], "events": [], "mediaMetadata": [], "albums": []
      },
      "expectedIssues": [
        { "severity": "ERROR", "entity": "members", "recordId": "m1", "reason": "Unrecognized key: zodiacSign (strict schema, DEF-17)" }
      ],
      "executeAllowed": false
    },
    {
