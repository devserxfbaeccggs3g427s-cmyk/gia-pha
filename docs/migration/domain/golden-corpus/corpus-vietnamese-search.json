    { "id": "s_binh2", "fullName": "Nguyen Van Binh", "note": "unaccented duplicate of s_binh", "placeOfBirth": "Ha Noi", "gender": "MALE", "generation": 1, "isAlive": true, "dateOfBirth": "1960-04-12" }
