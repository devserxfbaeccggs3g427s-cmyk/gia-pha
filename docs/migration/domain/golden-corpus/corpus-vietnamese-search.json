  "normalizationCases": [
    { "input": "Nguyễn Văn Bình", "expected": "nguyen van binh" },
    { "input": "  Đặng   Thị Dung ", "expected": "dang thi dung", "note": "đ→d, trim, collapse internal whitespace" },
