      ],
      "note": "s_dung ('dang thi dung') does not contain 'duong'; placeOfBirth 'hai duong' of s_duong already counted once per field rules"
    },
    {
      "id": "occupation-and-address-weights",
      "query": "giao vien",
      "expected": [
        { "memberId": "s_binh", "score": 15, "matchedFields": ["occupation"] }
      ]
    },
    {
      "id": "suggest-mode-prefix-max-10",
      "query": "b",
