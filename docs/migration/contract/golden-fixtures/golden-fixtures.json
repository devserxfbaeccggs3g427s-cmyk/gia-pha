      "id": "relationship-cycle-conflict",
      "operationId": "createRelationship",
      "request": {
        "method": "POST",
        "path": "/api/trees/tree_0001/relationships",
        "body": { "sourceMemberId": "mem_child", "targetMemberId": "mem_grandparent", "type": "PARENT_CHILD" }
      },
      "preState": { "edges": [["mem_grandparent", "mem_parent"], ["mem_parent", "mem_child"]] },
      "response": { "status": 409, "bodyMatch": { "ok": false, "error": { "code": "CYCLE_DETECTED" } } }
