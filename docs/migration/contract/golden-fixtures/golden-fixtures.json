    "timestamps": "ISO-8601 UTC with milliseconds",
    "errorEnvelope": { "ok": false, "error": { "code": "…", "message": "…", "details": "optional" } },
    "auth": "Session cookie of user usr_admin01 unless stated otherwise"
  },
  "fixtures": [
