# Required in production. Generate with: openssl rand -base64 32
# SECURITY: the value previously committed here was treated as compromised and must be
# rotated in every environment that ever used it (see docs/migration/ops/secret-rotation.md).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://192.168.2.23:3020

# Private Vercel Blob data store. `vercel env pull .env.local` normally provides
# BLOB_STORE_ID + VERCEL_OIDC_TOKEN. BLOB_READ_WRITE_TOKEN is the fallback.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Vercel Cron authenticates the daily /api/cron/backups request with this value.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Secure by default. Set false only for local/demo environments without email delivery.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# OAuth providers (leave empty to hide the provider button locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Transactional email for account verification (Resend)
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# --- Microservice decomposition research lane (Phase 0.1) ---
# Local docker-compose only. Never commit real secrets.
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DB=giapha
MYSQL_SVC_IDENTITY=identitypw
MYSQL_SVC_TREE=trepw
MYSQL_SVC_MEMBERS=mempw
MYSQL_SVC_RELATIONS=relpw
MYSQL_SVC_EVENTS=evpw
MYSQL_SVC_MEDIA=medpw
MYSQL_SVC_BINARY=binpw
MYSQL_SVC_SHARING=shapw
MYSQL_SVC_TRANSFER=trapw
MYSQL_SVC_REPORTING=reppw
MYSQL_SVC_AUDIT=audpw

RABBITMQ_USER=giapha
RABBITMQ_PASS=giapha

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- BFF -> Microservices gateway ---
# The Next.js BFF forwards every authenticated request through the
# Spring Cloud Gateway. In local docker-compose the gateway is reachable
# at http://localhost:8080; in dev it may be http://127.0.0.1:8080.
NEXT_PUBLIC_GIAPHA_SPRING_BASE_URL=http://localhost:8080
GIAPHA_SPRING_BASE_URL=http://gateway-service:8080

