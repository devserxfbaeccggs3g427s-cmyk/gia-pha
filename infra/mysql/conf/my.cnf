# MySQL server config for the research docker-compose.
# Intent: be conservative on a laptop; explicit defaults for reproducibility.
[mysqld]
default-time-zone = '+00:00'
innodb_file_per_table = ON
innodb_flush_log_at_trx_commit = 2
sync_binlog = 0
log_bin = ON
binlog_format = ROW
server-id = 1
# Local dev only — disable strict mode so seed scripts can run quickly.
sql_mode = "STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION"

[client]
default-character-set = utf8mb4
