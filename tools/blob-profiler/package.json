{
  "name": "blob-profiler",
  "private": true,
  "version": "1.0.0",
  "description": "Read-only Vercel Blob inventory and anomaly profiler for the Spring Boot migration (Task 2). Performs zero source writes.",
  "type": "module",
  "bin": { "profile-blobs": "./profile-blobs.mjs" },
  "scripts": {
    "profile": "node profile-blobs.mjs --out blob-profile-report.json",
    "prescan": "node profile-blobs.mjs --skip-content --out blob-prescan-report.json"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0"
  },
  "engines": { "node": ">=20" }
}
